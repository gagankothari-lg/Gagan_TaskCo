# ── apps/web production env (Vercel) — PLACEHOLDERS ONLY (safe to commit) ──
# Set the real values in the Vercel dashboard / CLI.

# The Railway backend URL. The api client appends "/api" (lib/api.ts), so use the
# bare origin WITHOUT a trailing /api.
NEXT_PUBLIC_API_URL="https://your-api.onrender.com"

# Portal Phase 7b: where unauthenticated visitors / expired sessions / logout are sent.
# LGDesk no longer has its own login page — this must be the Portal web URL for the
# SAME environment (dev Vercel project -> Portal's dev URL, prod -> Portal's prod URL).
NEXT_PUBLIC_PORTAL_URL="https://your-portal.vercel.app"

# ── Not currently read by the code (documented; harmless if set) ──
# NEXT_PUBLIC_APP_NAME="LG Desk"
# NEXT_PUBLIC_APP_ENV="production"
