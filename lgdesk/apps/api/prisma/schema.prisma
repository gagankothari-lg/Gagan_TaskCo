generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USER ──────────────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  empId         String    @unique
  firstName     String
  lastName      String
  email         String    @unique
  passwordHash  String
  role          String
  designation   String?
  managerId     String?
  team          String?
  subDepartment String?
  isActive      Boolean   @default(true)
  dob           DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Round4 F4: managerId is optional/nullable (org-hierarchy pointer, not a dependent
  // record) -- deleting a manager should orphan the link, not block or cascade.
  manager           User?                  @relation("Reports", fields: [managerId], references: [empId], onDelete: SetNull)
  reports           User[]                 @relation("Reports")
  workLogs          WorkLog[]
  internWorkLogs    InternWorkLog[]
  workDurations     WorkDuration[]
  leaves            Leave[]
  todos             Todo[]
  notes             Note[]
  ideas             Idea[]
  weeklySummaries   WeeklySummary[]
  progressUpdates   ProgressUpdate[]
  profileUpdateReqs ProfileUpdateRequest[]
  misAccess         MisAccess?
  auditLogs         AuditLog[]

  @@map("users")
}

model PasswordResetOtp {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_otps")
}

model RevokedToken {
  id        String   @id @default(cuid())
  jti       String   @unique
  empId     String
  expiresAt DateTime
  revokedAt DateTime @default(now())

  @@index([jti])
  @@map("revoked_tokens")
}

// ─── TASK ──────────────────────────────────────────────────────
model Task {
  id                String    @id @default(cuid())
  taskId            String    @unique
  projId            String?
  functionId        String?
  subFnId           String?
  title             String
  description       String?
  assigneeIds       String    @default("")
  assignedTeams     String    @default("")
  assignerId        String
  status            String    @default("Not Started")
  priority          String    @default("Medium")
  // Round4 checklist#1: deliberately kept ADDITIVE, not folded, despite recurring/
  // recurrencePattern being logically redundant. Dropping `recurring` would silently
  // destroy the one bit of signal every existing task row already has -- for any row
  // where recurring=true, there is no way to know which of the 5 real cadences
  // (One Time/Daily/Weekly/Monthly/Quarterly -- app.js.html:10480-10485, re-verified
  // directly) it should become, so a fold's default 'One Time' would silently convert
  // real recurring tasks to non-recurring with no record it happened. This batch's own
  // rule is "no existing-row data touched, additive columns only" -- so `recurring`
  // stays exactly as-is (untouched, still the legacy source of truth for anything old
  // that still reads it), and the service layer keeps it in sync going forward
  // (recurring := recurrencePattern !== 'One Time') on every create/update through the
  // new field, so it never goes stale for newly written rows either. Revisit as a
  // separate, explicitly-scoped migration if the boolean is ever worth removing.
  recurring         Boolean   @default(false)
  recurrencePattern String    @default("One Time")
  dueDate           DateTime?
  estimatedHours    Float?
  actualHours       Float     @default(0)
  fileLink          String?
  links             String?
  calEventId        String?
  assignmentHistory String    @default("[]")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Round4 F4: projId/functionId are optional categorization pointers (a task doesn't stop
  // existing if its project/function is deleted) -- SetNull, matching the subFunction
  // precedent immediately below (already explicit before this batch).
  project         Project?       @relation(fields: [projId], references: [projId], onDelete: SetNull)
  function        WorkFunction?  @relation("FunctionTasks", fields: [functionId], references: [functionId], onDelete: SetNull)
  subFunction     WorkFunction?  @relation("SubFunctionTasks", fields: [subFnId], references: [functionId], onDelete: SetNull)
  progressUpdates ProgressUpdate[]
  attachments     Attachment[]

  @@map("tasks")
}

// ─── PROJECT ───────────────────────────────────────────────────
model Project {
  id                String    @id @default(cuid())
  projId            String    @unique
  parentProjId      String?
  name              String
  description       String?
  ownerIds          String    @default("")
  assignerId        String
  assigneeIds       String    @default("")
  assignedTeams     String    @default("")
  status            String    @default("Not Started")
  priority          String    @default("Medium")
  startDate         DateTime?
  deadline          DateTime?
  chatLink          String?
  calEventId        String?
  assignmentHistory String    @default("[]")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Round4 F4: optional self-referencing hierarchy pointer -- same reasoning as
  // WorkFunction.parent below.
  parent      Project?       @relation("SubProjects", fields: [parentProjId], references: [projId], onDelete: SetNull)
  subProjects Project[]      @relation("SubProjects")
  tasks       Task[]
  functions   WorkFunction[]

  @@map("projects")
}

// ─── FUNCTION ──────────────────────────────────────────────────
model WorkFunction {
  id                String    @id @default(cuid())
  functionId        String    @unique
  parentFnId        String?
  projId            String?
  name              String
  description       String?
  assignerId        String
  assigneeIds       String    @default("")
  assignedTeams     String    @default("")
  status            String    @default("Not Started")
  priority          String    @default("Medium")
  startDate         DateTime?
  deadline          DateTime?
  calEventId        String?
  assignmentHistory String    @default("[]")
  links             String?
  createdById       String
  // Round4 F35: Function's own recurring cadence -- a real, live, saved field
  // (_saveFunctionEdit, app.js.html:11695-11775), independent of Task.recurrencePattern:
  // a distinct, wider 10-value vocabulary (setupSheets.gs:13,104), not shared with Task's
  // 5-value list. Replaces the DTO-only `recurringFunctions` boolean that already existed
  // in create/update-function.dto.ts but was never backed by a schema column, so it was
  // silently discarded before ever reaching functions.service.ts (confirmed: zero reads of
  // `dto.recurringFunctions` anywhere in that service) -- a dead field, not a working one.
  recurringPattern  String    @default("One Time")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Round4 F4: parentFnId/projId are optional categorization pointers -- SetNull.
  parent     WorkFunction?  @relation("SubFunctions", fields: [parentFnId], references: [functionId], onDelete: SetNull)
  children   WorkFunction[] @relation("SubFunctions")
  project    Project?       @relation(fields: [projId], references: [projId], onDelete: SetNull)
  tasks      Task[]         @relation("FunctionTasks")
  subFnTasks Task[]         @relation("SubFunctionTasks")

  @@map("work_functions")
}

// ─── WORK LOG ──────────────────────────────────────────────────
model WorkLog {
  id             String   @id @default(cuid())
  logId          String   @unique
  empId          String
  date           DateTime @db.Date
  month          String?
  dayName        String?
  attendance     String   @default("Present")
  purpose        String?
  leaveRequested String?
  work1stHalf    String?
  work2ndHalf    String?
  extraHours     Float    @default(0)
  remark         String?
  status         String?
  comments       String?
  workDuration   Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Round4 F4: required FK to User, an attendance/audit record. The app has no
  // hard-delete-user feature (only soft `deactivateEmployee`) -- Restrict makes that
  // already-implicit protection explicit rather than leaving it to Prisma/DB defaults.
  user User @relation(fields: [empId], references: [empId], onDelete: Restrict)

  @@unique([empId, date])
  @@map("work_logs")
}

model InternWorkLog {
  id          String   @id @default(cuid())
  logId       String   @unique
  empId       String
  date        DateTime @db.Date
  month       String?
  dayName     String?
  attendance  String   @default("Present")
  work1stHalf String?
  work2ndHalf String?
  extraHours  Float    @default(0)
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Round4 F4: same reasoning as WorkLog.user above.
  user User @relation(fields: [empId], references: [empId], onDelete: Restrict)

  @@unique([empId, date])
  @@map("intern_work_logs")
}

// ─── WORK DURATION (Clock) ─────────────────────────────────────
model WorkDuration {
  id             String    @id @default(cuid())
  sessionId      String    @unique
  empId          String
  date           DateTime  @db.Date
  clockIn        DateTime?
  clockOut       DateTime?
  totalBreakMins Int       @default(0)
  grossMinutes   Int       @default(0)
  netMinutes     Int       @default(0)
  status         String    @default("IDLE")
  autoClocked    Boolean   @default(false)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Round4 F4: same reasoning as WorkLog.user above -- clock-session audit record.
  user   User         @relation(fields: [empId], references: [empId], onDelete: Restrict)
  breaks WorkBreak[]

  @@unique([empId, date])
  @@map("work_durations")
}

model WorkBreak {
  id             String    @id @default(cuid())
  sessionId      String
  breakStart     DateTime
  breakEnd       DateTime?
  durationMins   Int       @default(0)

  // Round4 F4: DEVIATES from this batch's own "make everything Restrict" starting
  // suggestion -- flagged explicitly per instruction. sessionId is a REQUIRED FK (not
  // nullable, so SetNull isn't an option), but unlike WorkLog/Leave/etc.'s required FKs to
  // User, this one points to WorkDuration, not User -- there is no employee audit-trail
  // concern here. A WorkBreak row has no independent meaning or any read path outside its
  // parent clock session (a break with no session is meaningless, and nothing in the app
  // queries WorkBreak on its own) -- architecturally identical to ProgressUpdate.task's
  // existing Cascade precedent (a required FK to a "container" record the child cannot
  // outlive), not to the User-history relations Restrict protects. Cascade is therefore the
  // reasoned choice, not Restrict-by-default. (In practice this is currently dormant either
  // way -- there is no delete-WorkDuration feature to trigger it -- but Cascade is the
  // semantically correct annotation for if/when one is ever built.)
  session WorkDuration @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@map("work_breaks")
}

// ─── LEAVE ─────────────────────────────────────────────────────
model Leave {
  id          String    @id @default(cuid())
  leaveId     String    @unique
  empId       String
  leaveType   String
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  days        Float
  reason      String
  status      String    @default("Pending")
  reviewedBy  String?
  reviewNotes String?
  calEventId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Round4 F4: same reasoning as WorkLog.user above -- leave history is an audit record.
  user User @relation(fields: [empId], references: [empId], onDelete: Restrict)

  @@map("leaves")
}

model Holiday {
  id          String   @id @default(cuid())
  date        DateTime @db.Date @unique
  name        String
  // Round4 checklist#6: reference has a description field on Holiday; the rebuild didn't.
  description String?
  calEventId  String?
  createdAt   DateTime @default(now())

  @@map("holidays")
}

// ─── MEETING ───────────────────────────────────────────────────
model Meeting {
  id              String    @id @default(cuid())
  meetingId       String    @unique
  title           String
  description     String?
  organizerId     String
  attendeeIds     String    @default("")
  attendeeTeams   String    @default("")
  meetType        String    @default("personal")
  startTime       DateTime
  endTime         DateTime
  meetLink        String?
  calEventId      String?
  status          String    @default("Scheduled")
  cancelReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("meetings")
}

// ─── ANNOUNCEMENT ──────────────────────────────────────────────
model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String    @default("")
  authorId    String
  visibility  String    @default("Organisation")
  // Round4 checklist#7: re-derived from the reference's actual LIVE-reachable markup
  // (index.html #nb-type/#nb-priority selects), which outranks LGDesk_Master_Reference.md
  // Part 60 (that doc disagrees with the live selects and is stale here) and is narrower
  // than app.js.html's broader _NB_TYPE_ICON map (which also covers non-Announcement
  // synthesized notice kinds like Birthday/Meeting/Holiday -- not real Announcement values).
  // type: General/Emergency/Reminder. priority: Normal/High/Urgent (drives the notice
  // board's "Urgent" badge, _renderNoticeBoard's `n.priority === 'Urgent'` check).
  type        String    @default("General")
  priority    String    @default("Normal")
  startDate   DateTime?
  expiresAt   DateTime?
  isPinned    Boolean   @default(false)
  isActive    Boolean   @default(true) // BR-4 soft delete — never hard-deleted
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("announcements")
}

// ─── NOTES (personal) ──────────────────────────────────────────
model Todo {
  id        String   @id @default(cuid())
  empId     String
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Round4 F4: same reasoning as WorkLog.user above.
  user User @relation(fields: [empId], references: [empId], onDelete: Restrict)
  @@map("todos")
}

model Note {
  id        String   @id @default(cuid())
  empId     String
  title     String?
  content   String?
  pinned    Boolean  @default(false)
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Round4 F4: same reasoning as WorkLog.user above.
  user User @relation(fields: [empId], references: [empId], onDelete: Restrict)
  @@map("notes")
}

model Idea {
  id        String   @id @default(cuid())
  empId     String
  title     String?
  content   String?
  status    String   @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Round4 F4: same reasoning as WorkLog.user above.
  user User @relation(fields: [empId], references: [empId], onDelete: Restrict)
  @@map("ideas")
}

// ─── ATTACHMENT ────────────────────────────────────────────────
model Attachment {
  id           String   @id @default(cuid())
  attachmentId String   @unique
  taskId       String?
  projId       String?
  driveFileId  String
  fileName     String
  mimeType     String?
  webViewLink  String?
  uploadedBy   String
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())

  // Round4 F4: taskId is optional (an attachment can be un-linked, e.g. project-only via
  // projId), and attachments already have their own independent soft-delete lifecycle
  // (isDeleted, BR-17 -- the file stays in Google Drive regardless of the DB row's parent).
  // SetNull matches that existing "outlives its parent" design; Cascade would delete an
  // attachment record whose underlying file the app deliberately keeps.
  task Task? @relation(fields: [taskId], references: [taskId], onDelete: SetNull)

  @@map("attachments")
}

// ─── DUE DATE REQUEST ──────────────────────────────────────────
model DueDateRequest {
  id          String   @id @default(cuid())
  ddrId       String   @unique
  entityType  String
  entityId    String
  newDueDate  DateTime
  reason      String
  requestedBy String
  status      String   @default("Pending")
  reviewedBy  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("due_date_requests")
}

// ─── WEEKLY SUMMARY + MIS ──────────────────────────────────────
model WeeklySummary {
  id          String    @id @default(cuid())
  empId       String
  weekStart   DateTime
  content     String?
  isEdited    Boolean   @default(false)
  editedAt    DateTime?
  editedBy    String?
  aiModel     String?   @default("gemini-2.5-flash")
  generatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Round4 F4: same reasoning as WorkLog.user above.
  user User @relation(fields: [empId], references: [empId], onDelete: Restrict)

  @@unique([empId, weekStart])
  @@map("weekly_summaries")
}

model MisAccess {
  id        String   @id @default(cuid())
  empId     String   @unique
  email     String   @unique
  grantedAt DateTime @default(now())

  // Round4 F4: same reasoning as WorkLog.user above.
  user User @relation(fields: [empId], references: [empId], onDelete: Restrict)
  @@map("mis_access")
}

// ─── PROGRESS UPDATE ───────────────────────────────────────────
model ProgressUpdate {
  id          String   @id @default(cuid())
  updateId    String   @unique
  taskId      String
  projId      String?
  authorEmpId String
  date        DateTime @default(now())
  description String
  hoursLogged Float?
  blockers    String?
  createdAt   DateTime @default(now())

  task Task @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
  // Round4 F4: same reasoning as WorkLog.user above -- a progress update is authored
  // history, distinct from its `task` relation above (already explicit pre-batch).
  user User @relation(fields: [authorEmpId], references: [empId], onDelete: Restrict)

  @@map("progress_updates")
}

// ─── REGISTRATION REQUEST ──────────────────────────────────────
model RegistrationRequest {
  id            String   @id @default(cuid())
  regId         String   @unique
  firstName     String
  lastName      String
  // NOT @unique: a Rejected request must not permanently block re-registration.
  // Duplicate PENDING requests are prevented at the app level (see
  // UsersService.submitRegistration, which findFirst-checks status: 'Pending').
  email         String
  passwordHash  String
  designation   String?
  team          String?
  subDepartment String?
  managerId     String?
  role          String   @default("Team Member")
  status        String   @default("Pending")
  reviewedBy    String?
  notes         String?
  // Round4 F11: the registration form already collects DOB (registration-modal.tsx) but it
  // was discarded client-side before submission -- there was nowhere to put it. Typed
  // DateTime? to exactly match User.dob so approval-time promotion (approveRegistration)
  // needs no format conversion between the two.
  dob           DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("registration_requests")
}

// ─── PROFILE UPDATE REQUEST ────────────────────────────────────
model ProfileUpdateRequest {
  id          String   @id @default(cuid())
  reqId       String   @unique
  empId       String
  changes     String
  status      String   @default("Pending")
  reviewedBy  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Round4 F4: same reasoning as WorkLog.user above.
  user User @relation(fields: [empId], references: [empId], onDelete: Restrict)

  @@map("profile_update_requests")
}

// ─── AUDIT LOG ─────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  empId     String
  action    String
  entity    String
  entityId  String
  before    String?
  after     String?
  createdAt DateTime @default(now())

  // Round4 F4: same reasoning as WorkLog.user above -- audit logs are the audit trail
  // itself, the single relation this rule matters most for.
  user User @relation(fields: [empId], references: [empId], onDelete: Restrict)

  @@map("audit_logs")
}

// Persistent, monotonic per-prefix counters for IdUtilsService.generateId()
// (PFIX-ROUND3-CONFIRMED-BUGS Fix 1). Replaces the prior find-last-surviving-row+increment
// approach, which silently reused an ID whenever the highest-numbered row of a type was
// deleted. nextValue is always "the next number to issue" — read and incremented atomically
// via a single UPDATE...RETURNING in id.utils.ts, never derived from surviving business rows.
model IdCounter {
  prefix    String @id
  nextValue Int    @default(1)

  @@map("id_counters")
}
