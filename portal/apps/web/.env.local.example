NEXT_PUBLIC_API_URL=http://localhost:3002
# Google Sign-In (Phase 6). Not secret -- safe to expose client-side. Leave unset until a
# real OAuth Client ID exists; the "Continue with Google" button simply won't render.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Phase P26: LGDesk's own URL for THIS SAME environment -- the login page's "Forgot
# password?" link points at ${NEXT_PUBLIC_LGDESK_URL}/forgot-password (LGDesk kept that
# one flow itself; Portal has no reset feature of its own yet). Leave unset and the link
# simply won't render.
NEXT_PUBLIC_LGDESK_URL=http://localhost:3000
