generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "portal"]
}

// ─── USER (LGDesk-owned; Portal reads/writes this table but never migrates it) ──
// Field-for-field mirror of LGDesk's apps/api/prisma/schema.prisma `User` model, re-read
// fresh 2026-09-12 (Phase 3). Deliberately omits every relation to a domain model Portal
// doesn't declare (WorkLog, Leave, Task, etc. — those live only in LGDesk's own schema) and
// the self-referential manager/reports relation — Portal only needs identity, not the org
// graph. Prisma would refuse to validate a relation to an undeclared model anyway. Scalar
// columns (including managerId as a plain string) match the real table exactly.
model User {
  id                 String    @id @default(cuid())
  empId              String    @unique
  firstName          String
  lastName           String
  email              String    @unique
  passwordHash       String
  role               String
  designation        String?
  managerId          String?
  team               String?
  subDepartment      String?
  isActive           Boolean   @default(true)
  dob                DateTime?
  presenceStatus     String    @default("online")
  presenceUpdatedAt  DateTime?
  personalCalendarId String?
  googleSub          String?   @unique
  googleEmail        String?
  googleLinkedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("users")
  @@schema("public")
}

model RevokedToken {
  id        String   @id @default(cuid())
  jti       String   @unique
  empId     String
  expiresAt DateTime
  revokedAt DateTime @default(now())

  @@index([jti])
  @@map("revoked_tokens")
  @@schema("public")
}

// ─── ID COUNTER (LGDesk-owned; Portal reads/writes this table but never migrates it) ──
// Shared sequential-ID generator (REG-XXXXX etc.) — Portal must keep using this same
// counter for regId so it continues LGDesk's exact existing sequence, never restarting
// or colliding with it.
model IdCounter {
  prefix    String @id
  nextValue Int    @default(1)

  @@map("id_counters")
  @@schema("public")
}

// ─── REGISTRATION REQUEST (Portal-owned as of P18 Part 0 — moved from LGDesk) ──
// Field-for-field mirror of LGDesk's current RegistrationRequest, re-read fresh 2026-09-12,
// plus googleSub/googleEmail (Part 1's Google-assisted registration path). LGDesk's own
// schema.prisma keeps declaring this model too (read/write, no migrations) against its new
// physical location; Portal is the sole migration owner going forward.
model RegistrationRequest {
  id            String    @id @default(cuid())
  regId         String    @unique
  firstName     String
  lastName      String
  email         String
  passwordHash  String
  designation   String?
  team          String?
  subDepartment String?
  managerId     String?
  role          String    @default("Team Member")
  status        String    @default("Pending")
  reviewedBy    String?
  notes         String?
  dob           DateTime?
  // Google-assisted registration (P18 Part 1): populated only when the applicant submitted
  // a verified googleIdToken alongside manual fields. A password is still always required.
  googleSub     String?   @unique
  googleEmail   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("registration_requests")
  @@schema("portal")
}

// ─── PROFILE UPDATE REQUEST (Portal-owned as of P20 Part 0 — moved from LGDesk) ──
// Field-for-field mirror of LGDesk's current ProfileUpdateRequest, re-read fresh
// 2026-09-12. The real table has a `user User @relation(..., onDelete: Restrict)` FK to
// users.empId, kept intact by the physical schema move (Postgres cross-schema FKs work
// natively) -- deliberately NOT declared as a Prisma relation here, same as
// RegistrationRequest.managerId: Portal's own User model omits back-relations by design
// (Phase 3), and Portal doesn't need Prisma-level joins from this table, just the plain
// empId scalar. LGDesk's own schema.prisma keeps declaring the real relation (read/write,
// no migrations) against this table's new physical location; Portal is the sole migration
// owner going forward.
model ProfileUpdateRequest {
  id         String   @id @default(cuid())
  reqId      String   @unique
  empId      String
  changes    String
  status     String   @default("Pending")
  reviewedBy String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("profile_update_requests")
  @@schema("portal")
}

// ─── SOFTWARE TILE ─────────────────────────────────────────────
// Portal-owned. The tile-grid launcher (Phase 6) reads this to know which pillars to show.
model SoftwareTile {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "lgdesk"
  label     String
  url       String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("portal")
}
